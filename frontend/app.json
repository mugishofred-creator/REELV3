{
  "expo": {
    "name": "JobPilot",
    "slug": "jobpilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jobpilot",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "primaryColor": "#39FF14",
    "backgroundColor": "#0a0a0f",
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0a0a0f",
      "translucent": false
    },
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0a0a0f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jobpilot.app",
      "infoPlist": {
        "NSDocumentsFolderUsageDescription": "Sélectionne ton CV depuis tes fichiers",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.jobpilot.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0a0a0f"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0a0a0f"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#39FF14"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6adc62b9-6a18-4f23-8833-808cc4887138"
      }
    },
    "owner": "eueuuejejjejd"
  }
}
