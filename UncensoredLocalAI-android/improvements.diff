import 'dart:async';
import 'dart:convert';

import 'package:get/get.dart';
import 'package:http/http.dart' as http;

import 'chat_storage_service.dart';
import 'log_service.dart';

/// Streams chat completions from a remote OpenAI-compatible server.
///
/// This lets even low-end phones use a powerful model that is hosted
/// elsewhere (e.g. a GPU server running vLLM, llama.cpp `--server`, Ollama,
/// LM Studio, or any OpenAI-compatible API). The phone only sends/receives
/// text, so no local model download or heavy on-device inference is needed.
///
/// Note: in remote mode the conversation leaves the device and is processed
/// by the configured server — unlike the fully on-device local mode.
class RemoteLlmService extends GetxService {
  http.Client? _client;
  bool _cancelled = false;

  ChatStorageService get _storage => Get.find<ChatStorageService>();

  /// True when remote mode is enabled and a server URL is configured.
  bool get isConfigured =>
      _storage.useRemoteServer && _storage.remoteBaseUrl.trim().isNotEmpty;

  /// Build the /v1/chat/completions endpoint from the configured base URL.
  /// Accepts bases like `http://host:8080`, `.../v1`, or a full
  /// `.../v1/chat/completions` URL.
  Uri _endpoint() {
    var base = _storage.remoteBaseUrl.trim();
    while (base.endsWith('/')) {
      base = base.substring(0, base.length - 1);
    }
    if (base.endsWith('/chat/completions')) {
      // already a full endpoint
    } else if (base.endsWith('/v1')) {
      base = '$base/chat/completions';
    } else {
      base = '$base/v1/chat/completions';
    }
    return Uri.parse(base);
  }

  Map<String, String> _headers() {
    final headers = <String, String>{'Content-Type': 'application/json'};
    final key = _storage.remoteApiKey.trim();
    if (key.isNotEmpty) headers['Authorization'] = 'Bearer $key';
    return headers;
  }

  String _modelName() {
    final name = _storage.remoteModelName.trim();
    // Many self-hosted servers ignore the model field or accept any value.
    return name.isEmpty ? 'local-model' : name;
  }

  List<Map<String, String>> _buildMessages(
    List<Map<String, String>> history,
    String? systemPrompt,
  ) {
    final messages = <Map<String, String>>[];
    if (systemPrompt != null && systemPrompt.trim().isNotEmpty) {
      messages.add({'role': 'system', 'content': systemPrompt});
    }
    messages.addAll(history);
    return messages;
  }

  /// Cancel an in-progress remote generation.
  void stop() {
    _cancelled = true;
    _client?.close();
    _client = null;
  }

  /// Generate a streaming response from the remote server.
  /// Signature mirrors [LlmService.generate] so callers can swap transparently.
  Stream<String> generate({
    required List<Map<String, String>> messages,
    String? systemPrompt,
    double temperature = 0.7,
  }) async* {
    LogService? log;
    try {
      log = Get.find<LogService>();
    } catch (_) {}

    _cancelled = false;
    final body = jsonEncode({
      'model': _modelName(),
      'messages': _buildMessages(messages, systemPrompt),
      'temperature': temperature,
      'stream': true,
    });

    final client = http.Client();
    _client = client;
    try {
      log?.info('Remote request → ${_endpoint()}', source: 'REMOTE');
      final request = http.Request('POST', _endpoint())
        ..headers.addAll(_headers())
        ..body = body;
      final response = await client.send(request);

      if (response.statusCode < 200 || response.statusCode >= 300) {
        final errBody = await response.stream.bytesToString();
        log?.error('Remote API ${response.statusCode}: $errBody',
            source: 'REMOTE');
        throw Exception(
          'Server returned ${response.statusCode}. '
          '${errBody.isEmpty ? 'Check the URL, API key and model name.' : errBody}',
        );
      }

      final lines = response.stream
          .transform(utf8.decoder)
          .transform(const LineSplitter());

      await for (final line in lines) {
        if (_cancelled) break;
        final trimmed = line.trim();
        if (trimmed.isEmpty || !trimmed.startsWith('data:')) continue;
        final data = trimmed.substring(5).trim();
        if (data == '[DONE]') break;
        try {
          final decoded = jsonDecode(data) as Map<String, dynamic>;
          final choices = decoded['choices'] as List?;
          if (choices == null || choices.isEmpty) continue;
          final first = choices.first as Map<String, dynamic>;
          // Streaming uses `delta`; some servers send full `message`.
          final delta = first['delta'] as Map<String, dynamic>?;
          final message = first['message'] as Map<String, dynamic>?;
          final content = (delta?['content'] ?? message?['content']);
          if (content is String && content.isNotEmpty) {
            yield content;
          }
        } catch (_) {
          // Ignore keep-alive comments / malformed partial lines.
        }
      }
    } finally {
      client.close();
      if (identical(_client, client)) _client = null;
    }
  }

  /// Quick connectivity + auth check used by the Settings screen.
  Future<RemoteTestResult> testConnection() async {
    if (_storage.remoteBaseUrl.trim().isEmpty) {
      return const RemoteTestResult(false, 'Enter a server URL first.');
    }
    try {
      final body = jsonEncode({
        'model': _modelName(),
        'messages': [
          {'role': 'user', 'content': 'ping'}
        ],
        'max_tokens': 1,
        'stream': false,
      });
      final response = await http
          .post(_endpoint(), headers: _headers(), body: body)
          .timeout(const Duration(seconds: 20));
      if (response.statusCode >= 200 && response.statusCode < 300) {
        return const RemoteTestResult(true, 'Connected — server is reachable.');
      }
      var detail = response.body;
      if (detail.length > 200) detail = '${detail.substring(0, 200)}…';
      return RemoteTestResult(false, 'Server ${response.statusCode}: $detail');
    } catch (e) {
      return RemoteTestResult(false, 'Connection failed: $e');
    }
  }
}

class RemoteTestResult {
  final bool ok;
  final String message;
  const RemoteTestResult(this.ok, this.message);
}
